# =============================================================================
# .env.example — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
#
#   cp .env.example .env
#
# NEVER commit .env to Git. This file (.env.example) is safe to commit.
# =============================================================================

# Google Gemini API Key
# Generate one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend server port
# The Docker container exposes this port (default: 3001)
PORT=3001